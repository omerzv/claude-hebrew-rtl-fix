{
  "manifest_version": 3,
  "name": "Claude.ai Hebrew Bidi Fixer",
  "version": "1.1.0",
  "description": "Fixes Hebrew-English bidirectional text rendering in Claude.ai messages and composer. Fully client-side, no network requests.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Claude.ai Hebrew Bidi Fixer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["bidi_processor.js", "content_script.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "hebrew-bidi-fixer@omerzv33.github.io",
      "strict_min_version": "115.0"
    }
  }
}
