{
  "manifest_version": 3,
  "name": "Claude.ai Hebrew Bidi Fixer",
  "version": "1.0.0",
  "description": "Fixes Hebrew-English bidirectional text rendering in Claude.ai assistant messages. Fully client-side, no network requests.",
  "permissions": ["storage"],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["bidi_processor.js", "content_script.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "hebrew-bidi-fixer@example.com",
      "strict_min_version": "115.0"
    }
  }
}
